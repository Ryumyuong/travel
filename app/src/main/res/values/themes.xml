<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Travel" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/noto_sans_kr</item>

        <item name="colorPrimary">#3653AE</item>
        <item name="colorOnPrimary">#EBEEF8</item>
        <item name="colorPrimaryContainer">@color/neutral_light_gray</item>
        <item name="colorOnPrimaryContainer">@color/neutral_black</item>

        <item name="colorSecondary">@color/neutral_gray</item>
        <item name="colorOnSecondary">@color/neutral_white</item>

        <item name="colorSurface">@color/neutral_white</item>
        <item name="colorOnSurface">@color/neutral_black</item>
        <item name="colorOutline">@color/neutral_gray</item>

        <!-- Ripple 완전 제거 -->
        <item name="colorControlHighlight">@color/transparent</item>

        <!-- 시스템 바 -->
        <item name="android:statusBarColor">@color/neutral_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/neutral_white</item>

        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
    </style>

    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/NoActiveIndicator</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="android:background">@color/white</item>
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">12dp</item>
    </style>

    <style name="Theme.Travel" parent="Base.Theme.Travel" />
</resources>