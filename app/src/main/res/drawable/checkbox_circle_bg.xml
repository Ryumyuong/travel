<?xml version="1.0" encoding="utf-8"?>
<!-- 원형 체크박스 배경 + 체크 PNG 아이콘 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 선택된 상태 - 코랄 배경 + 체크 PNG -->
    <item android:state_checked="true">
        <layer-list>
            <!-- 원형 배경 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#F25F5C" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
            <!-- 체크 PNG 아이콘 -->
            <item
                android:width="16dp"
                android:height="16dp"
                android:gravity="center"
                android:drawable="@drawable/check_icon" />
        </layer-list>
    </item>
    <!-- 기본 상태 - 회색 배경 + 회색 체크 -->
    <item>
        <layer-list>
            <!-- 원형 배경 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#E9E9E9" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
            <!-- 체크 PNG 아이콘 -->
            <item
                android:width="16dp"
                android:height="16dp"
                android:gravity="center"
                android:drawable="@drawable/check_icon" />
        </layer-list>
    </item>
</selector>