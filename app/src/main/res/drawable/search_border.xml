<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 테두리 -->
    <stroke
        android:width="3dp"
        android:color="#EBEEF8" />

    <!-- 둥근 모서리 -->
    <corners android:radius="15dp" />

    <!-- 배경색 -->
    <solid android:color="#FFFFFF" />

    <!-- 안쪽 여백 -->
    <padding
        android:left="14dp"
        android:top="4dp"
        android:right="14dp"
        android:bottom="4dp" />
</shape>
