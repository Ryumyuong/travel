<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 선택된 상태 -->
    <item android:state_selected="true">
        <layer-list>
            <!-- 그림자 레이어 -->
            <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1A000000"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- 메인 버튼 레이어 -->
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F4F6FD"/>
                    <corners android:radius="12dp"/>
                    <stroke android:color="#3653AE" android:width="2dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- 기본 상태 -->
    <item>
        <layer-list>
            <!-- 그림자 레이어 -->
            <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1A000000"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- 메인 버튼 레이어 -->
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF"/>
                    <corners android:radius="12dp"/>
                    <stroke android:color="#E5E7EB" android:width="1dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>