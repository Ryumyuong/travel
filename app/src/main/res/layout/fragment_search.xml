<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- 콘텐츠 영역 - 중앙 정렬 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 숨겨진 TextView들 (코틀린 코드 호환성 유지) -->
        <TextView
            android:id="@+id/name1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/name2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- 텍스트와 강아지 이미지 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/tvUserGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="사용자"
                        android:textColor="#3653AE"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="님,"
                        android:textColor="#000000"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/travel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:padding="0dp"
                    android:text="어디로\n떠나실래요?"
                    android:textColor="#000000"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_search_page_sammy"
                android:scaleType="fitCenter"
                android:layout_gravity="bottom"
                android:layout_marginBottom="-30dp"
                android:elevation="10dp"/>

        </LinearLayout>

        <!-- 검색 영역 -->
        <LinearLayout
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/search_box_border"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/etSearchCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="나라를 입력해주세요"
                    android:includeFontPadding="false"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingLeft="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@null"
                    android:paddingRight="50dp"/>

                <ImageView
                    android:id="@+id/btnSearchCountry"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/icon"/>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 배너 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/banner_basic_ad"
        android:scaleType="fitXY"
        android:contentDescription="광고 배너" />

</LinearLayout>
