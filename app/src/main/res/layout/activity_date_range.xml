<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="30dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:layout_marginTop="0dp">

                <TextView
                    android:id="@+id/tvTitle1"
                    android:text="여행 일정과"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:padding="0dp"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvTitle2"
                    android:text="원하는 여행 키워드를 선택해주세요"
                    android:textSize="20sp"
                    android:layout_marginTop="2dp"
                    android:padding="0dp"
                    android:includeFontPadding="false"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"
                    android:background="?attr/colorOutline"/>

                <!-- 달력 헤더 (좌/우 화살표 + 월 텍스트) -->
                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="30dp">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/vec1" />

                    <TextView
                        android:id="@+id/tvMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textSize="24sp"
                        android:text="2025년 8월"/>

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/vec2" />
                </LinearLayout>

                <!-- 요일 헤더 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <!-- Mon~Sun -->
                    <TextView style="@style/Cal.Week" android:text="Mon"/>
                    <TextView style="@style/Cal.Week" android:text="Tue"/>
                    <TextView style="@style/Cal.Week" android:text="Wed"/>
                    <TextView style="@style/Cal.Week" android:text="Thu"/>
                    <TextView style="@style/Cal.Week" android:text="Fri"/>
                    <TextView style="@style/Cal.Week" android:text="Sat"/>
                    <TextView style="@style/Cal.Week" android:text="Sun"/>
                </LinearLayout>

                <!-- 캘린더 그리드 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:layout_marginTop="6dp"/>
                <TextView
                    android:id="@+id/tvPicked"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:text="기간을 선택해주세요."/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/line"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"/>


                <!-- 키워드 칩 (원하든 만큼 추가) -->

                <!-- 버튼 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="30dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:singleLine="false"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🌿 한적한 자연"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🏨 호캉스"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🛁 온천/스파"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🏙 핫플 투어"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🧘‍♀️ 힐링"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="☕️️ 카페 투어"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🏖️ 휴양지"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🍝️ 맛집"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🗿️️ 역사탐험"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="⛰️ 등산 / 트레킹"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="💍 신혼여행"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrev"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="이전단계"
                        android:backgroundTint="#EBEEF8"/>

                    <Space android:layout_width="12dp" android:layout_height="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirm"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="선택완료"/>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="80dp"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 하단 네비게이션 (원하면 SearchActivity와 동일 아이디 사용) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    app:menu="@menu/menu_bottom_three"
    app:itemIconTint="@null"
    app:itemTextColor="@color/bnv_text_color"

    app:itemRippleColor="@android:color/transparent"
    app:itemBackground="@android:color/transparent"
    android:background="@color/white"
    app:itemActiveIndicatorStyle="@style/NoActiveIndicator"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
