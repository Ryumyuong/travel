<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/actionBarSize"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:fillViewport="true"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="여행 일정과"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="원하는 여행 키워드를 선택해주세요"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"
                    android:background="?attr/colorOutline" />

                <!-- 달력 헤더 (좌/우 화살표 + 월 텍스트) -->
                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="30dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/vec1" />

                    <TextView
                        android:id="@+id/tvMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="24sp"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center"
                        android:text="2025년 8월"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/vec2" />
                </LinearLayout>

                <!-- 요일 헤더 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <!-- Mon~Sun -->
                    <TextView
                        style="@style/Cal.Week"
                        android:text="Mon" />

                    <TextView
                        style="@style/Cal.Week"
                        android:text="Tue" />

                    <TextView
                        style="@style/Cal.Week"
                        android:text="Wed" />

                    <TextView
                        style="@style/Cal.Week"
                        android:text="Thu" />

                    <TextView
                        style="@style/Cal.Week"
                        android:text="Fri" />

                    <TextView
                        style="@style/Cal.Week"
                        android:text="Sat" />

                    <TextView
                        style="@style/Cal.Week"
                        android:text="Sun" />
                </LinearLayout>

                <!-- 캘린더 그리드 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvPicked"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:text="기간을 선택해주세요." />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"
                    android:src="@drawable/line" />


                <!-- 키워드 칩 (원하든 만큼 추가) -->

                <!-- 버튼 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:singleLine="false"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🌿 한적한 자연"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🏨 호캉스"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🛁 온천/스파"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🏙 핫플 투어"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🧘‍♀️ 힐링"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="☕️️ 카페 투어"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🏖️ 휴양지"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🍝️ 맛집"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="🗿️️ 역사탐험"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="⛰️ 등산 / 트레킹"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.App.TagChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="💍 신혼여행"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.google.android.material.chip.ChipGroup>

                <!-- 더보기 및 새로고침 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal">

                    <!-- 더보기 버튼 -->
                    <LinearLayout
                        android:id="@+id/btnMoreOptions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_add" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="더보기"
                            android:textColor="#979797"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 새로고침 버튼 -->
                    <LinearLayout
                        android:id="@+id/btnRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_refresh" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="새로고침"
                            android:textColor="#979797"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPrev"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_prev_step"
                        android:stateListAnimator="@null"
                        android:elevation="0dp"
                        android:includeFontPadding="false"
                        android:padding="12dp"
                        android:text="이전단계"
                        android:textColor="#6378C4"
                        android:textSize="16sp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnConfirm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_confirm"
                        android:includeFontPadding="false"
                        android:padding="12dp"
                        android:text="선택완료"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="80dp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 하단 네비게이션 (원하면 SearchActivity와 동일 아이디 사용) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/menu_bottom_three"
        app:itemIconTint="@null"
        app:itemTextColor="@color/bnv_text_color"
        app:itemRippleColor="@android:color/transparent"
        app:itemBackground="@android:color/transparent"
        android:background="@color/white"
        app:itemActiveIndicatorStyle="@style/NoActiveIndicator"/>

    <!-- 로딩 오버레이 -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:indeterminateTint="@color/white" />

            <TextView
                android:id="@+id/tvLoadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="AI가 일정을 생성하고 있어요"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoadingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="잠시만 기다려주세요..."
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
