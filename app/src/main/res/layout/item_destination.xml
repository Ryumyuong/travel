<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.App.CardView"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_destination_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/destination_positano"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_destination_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_tourist_attraction"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:background="@drawable/category_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_destination_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/destination_positano_desc"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="16sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="위치 정보"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.8"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/orange_accent" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>