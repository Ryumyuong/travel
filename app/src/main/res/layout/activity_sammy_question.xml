<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    tools:context=".SammyQuestionActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvQuestion1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Q. 제가 뭐라고 부르면 될까요?"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etNickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@null"
            android:hint="이름을 입력해주세요"
            android:paddingBottom="8dp"
            android:textColor="#3653AE"
            android:textColorHint="#3653AE"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestion1" />

        <TextView
            android:id="@+id/tvQuestion2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Q. 성별을 알려주세요"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etNickname" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestion2">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#3653AE"
                android:checked="true"
                android:text="남자"
                android:textColor="#000000"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:buttonTint="#3653AE"
                android:text="여자"
                android:textColor="#000000"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvQuestion3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="연령대를 알려주세요"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rgGender" />

        <SeekBar
            android:id="@+id/seekBarAge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="4"
            android:progress="2"
            android:progressTint="#3653AE"
            android:thumbTint="#3653AE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestion3" />

        <!-- Age Labels -->
        <LinearLayout
            android:id="@+id/llAgeLabels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/seekBarAge"
            app:layout_constraintStart_toStartOf="@id/seekBarAge"
            app:layout_constraintTop_toBottomOf="@id/seekBarAge">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10대"
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="20대"
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30대"
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="40대"
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="50대"
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llAgeLabels"
            app:singleLine="false"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🌿 한적한 자연"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🏨 호캉스"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🛁 온천/스파"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🏙 핫플 투어"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🧘‍♀️ 힐링"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="☕️️ 카페 투어"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🏖️ 휴양지"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🍝️ 맛집"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🗿️️ 역사탐험"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="⛰️ 등산 / 트레킹"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.App.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="💍 신혼여행"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.chip.ChipGroup>


        <LinearLayout
            android:id="@+id/llActionButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipGroup">

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="더보기"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add" />

            <TextView
                android:id="@+id/tvMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="더보기"
                android:textColor="#666666"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="새로고침"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />

            <TextView
                android:id="@+id/tvRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새로고침"
                android:textColor="#666666"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Next Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_blue_rounded"
            android:text="다음으로"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llActionButtons" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>