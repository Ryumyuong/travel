<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="vertical"
        android:background="@drawable/top_picture"
        android:paddingLeft="30dp"
        android:paddingTop="50dp">
        <TextView
            android:id="@+id/headcountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="발리"
            android:background="@drawable/button_black"
            android:textSize="10sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="휴가를 즐기러 온"
                android:textStyle="bold"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textStyle="bold"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4박 5일 "
                android:textStyle="bold"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textStyle="bold"
                android:textColor="@color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 여행은 이렇게 준비했어요!"
                android:textStyle="bold"
                android:textColor="@color/white"/>

        </LinearLayout>



    </LinearLayout>



    <!-- 헤더 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="30dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <!--  날짜 정보  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tv_round"
            android:backgroundTint="#F3F3F3"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/calendar_icon_small"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일정"
                android:textColor="#3653AE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025.08.01 - 2025.08.05"
                android:textSize="14sp"
                android:textColor="#333333" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/brand_primary"
        app:tabIndicatorHeight="2dp"
        app:tabIndicatorFullWidth="false"/>

     <!-- 일정편집 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/btnEditSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_edit"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일정편집"
                android:textSize="13sp"
                android:textColor="#666666" />

        </LinearLayout>

    </LinearLayout>

    <!-- 리사이클러뷰 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="30dp"
        android:clipToPadding="false"/>

    <!-- 일반 모드 버튼 -->
    <LinearLayout
        android:id="@+id/preButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="48dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:orientation="vertical">

        <!-- 첫 번째 줄: 이전단계 + 내 일정에 추가 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="이전단계"
                android:background="@drawable/button_recent_search"
                android:backgroundTint="#EBEEF8"
                android:textColor="#6378C4"
                android:textSize="14sp"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:includeFontPadding="false"/>

            <Space android:layout_width="12dp"
                android:layout_height="1dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddToSchedule"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="내 일정에 추가"
                android:background="@drawable/button_recent_search"
                android:backgroundTint="#EBEEF8"
                android:textColor="#6378C4"
                android:textSize="14sp"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- 두 번째 줄: 나에게 딱 맞는 여행을 찾았다면? -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFindPerfectTrip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="나에게 딱 맞는 여행을 찾았다면?"
            android:background="@drawable/btn_blue_rounded"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- 선택 모드 버튼들 -->
    <LinearLayout
        android:id="@+id/layoutSelectionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="선택취소"
                android:background="@drawable/button_prev_step"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:textColor="#6378C4"
                android:textSize="16sp"
                android:padding="12dp"
                android:includeFontPadding="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnComplete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="편집완료"
                android:background="@drawable/button_confirm"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="12dp"
                android:includeFontPadding="false" />

        </LinearLayout>


    </LinearLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/menu_bottom_three"
        app:itemIconTint="@null"
        app:itemTextColor="@color/bnv_text_color"
        app:itemRippleColor="@android:color/transparent"
        app:itemBackground="@android:color/transparent"
        android:background="@color/white"
        app:itemActiveIndicatorStyle="@style/NoActiveIndicator"/>

</LinearLayout>
