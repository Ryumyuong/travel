<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="일정표"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back_white" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.App.CardView"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="40sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_itinerary_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/itinerary_title"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:textSize="20sp"
                    android:textColor="@color/orange_accent"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="완벽하게 계획된 럭셔리 여행"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <!-- Day Selection Tabs -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/tab_background"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tab_day1"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:text="1일차"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/tab_selected_bg"
                        android:gravity="center"
                        android:layout_marginEnd="2dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tab_day2"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:text="2일차"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/purple_primary"
                        android:gravity="center"
                        android:layout_marginEnd="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/tab_day3"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:text="3일차"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/purple_primary"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Summary Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.App.CardView"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍"
                        android:textSize="20sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15개"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        android:textSize="18sp"
                        android:textColor="@color/orange_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="방문지"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.App.CardView"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏰"
                        android:textSize="20sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="36시간"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        android:textSize="18sp"
                        android:textColor="@color/orange_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="총 시간"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Itinerary List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_itinerary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="다운로드"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="8dp"
                android:layout_marginEnd="8dp"
                style="@style/Widget.App.Button.Secondary" />

            <Button
                android:id="@+id/btn_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="공유하기"
                android:drawableStart="@drawable/ic_share"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                style="@style/Widget.App.Button.Primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>