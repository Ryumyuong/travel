<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <!-- 로딩 컨테이너 -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/white"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminateTint="#3653AE" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="맞춤 여행을 준비하고 있어요..."
            android:textColor="#666666"
            android:textSize="16sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 결과 컨테이너 -->
    <LinearLayout
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:background="@drawable/top_picture"
            android:paddingLeft="30dp"
            android:paddingTop="50dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- 새미패스 뱃지 -->
                <TextView
                    android:id="@+id/sammyPassLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새미패스"
                    android:background="@drawable/button_sammy_pass"
                    android:textSize="10sp"
                    android:paddingLeft="10dp"
                    android:includeFontPadding="false"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="#6378C4"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="님의 발리 여행,"
                android:textStyle="bold"
                android:textSize="18sp"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tvHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="갓성비 있게 안내드려요!"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- 스크롤 가능한 컨텐츠 영역 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="30dp"
                android:paddingVertical="20dp">

                <!-- 최저가 Best 비행기 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvFlightTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="최저가 Best 비행기"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:id="@+id/btnRefreshFlight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다시추천"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:drawableEnd="@drawable/ic_refresh"
                        android:drawablePadding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutFlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvFlightDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="제주항공 7C1603편"
                        android:textSize="16sp"
                        android:textColor="#333333"/>

                    <ImageView
                        android:id="@+id/ivAirlineLogo"
                        android:layout_width="80dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_jejuair"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#CCCCCC"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="24dp"/>

                <!-- 발리의 가성비 Best 숙소 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvAccommodationTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="발리의 가성비 Best 숙소"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:id="@+id/btnRefreshAccommodation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다시추천"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:drawableEnd="@drawable/ic_refresh"
                        android:drawablePadding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAccommodation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvAccommodationDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="호시노야 발리"
                        android:textSize="16sp"
                        android:textColor="#333333"/>

                    <ImageView
                        android:id="@+id/ivBookingSiteLogo"
                        android:layout_width="80dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_hotels_com"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#CCCCCC"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="24dp"/>

                <!-- 가격도 저렴하지만 맛까지 챙긴 실속 맛집 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvRestaurantTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="가격도 저렴하지만 맛까지 챙긴\n실속 맛집"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:id="@+id/btnRefreshRestaurant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다시추천"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:drawableEnd="@drawable/ic_refresh"
                        android:drawablePadding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRestaurant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvRestaurantDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cretya Ubud"
                        android:textSize="16sp"
                        android:textColor="#333333"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#CCCCCC"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"/>

            </LinearLayout>

        </ScrollView>

        <!-- 하단 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveTrip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_recent_search"
                android:backgroundTint="#EBEEF8"
                android:text="여행 저장하기"
                android:textColor="#6378C4"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:includeFontPadding="false"
                android:layout_marginBottom="12dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_blue_rounded"
                android:elevation="0dp"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="여행 다시 시작하기"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:menu="@menu/menu_bottom_three"
            app:itemIconTint="@null"
            app:itemTextColor="@color/bnv_text_color"
            app:itemRippleColor="@android:color/transparent"
            app:itemBackground="@android:color/transparent"
            android:background="@color/white"
            app:itemActiveIndicatorStyle="@style/NoActiveIndicator"/>

    </LinearLayout>

</FrameLayout>
