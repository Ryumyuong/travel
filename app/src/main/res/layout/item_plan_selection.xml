<?xml version="1.0" encoding="utf-8"?>
<!-- *** 선택 모드 아이템 - 둥근 배경과 원형 체크박스 디자인 *** -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/selection_item_bg"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:gravity="center_vertical">

    <!-- 왼쪽 원형 체크박스 -->
    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/checkbox_circle_bg"
        android:button="@null"
        android:buttonTint="@android:color/transparent"
        android:clickable="false" />

    <!-- 중앙 텍스트 영역 -->

    <!-- 오른쪽 햄버거 메뉴 아이콘 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Revolver Espresso"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="분위기 좋은 시크한 로컬 카페"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginTop="-5dp" />

    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/hemburg_menu"
        android:layout_marginStart="16dp"
        android:scaleType="centerInside" />

</LinearLayout>