<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffffff">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingHorizontal="24dp">

        <!-- Back Button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_left_arrow"
                android:contentDescription="뒤로가기" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="여행취향찾기"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- Progress Indicators -->
        <LinearLayout
            android:id="@+id/progress_indicators"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/indicator_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_10"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_11"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <View
                android:id="@+id/indicator_12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#E5E7EB" />

        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <!-- Question Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Question Tag -->
            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="퇴사 D-1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3653AE"
                android:layout_marginBottom="16dp" />

            <!-- Question Text -->
            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="사직서 던지고 내일 출국하는 당신,\n오늘은?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!-- Option Buttons -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_option1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="여행 전 체크리스트를 만들어 하나 씩 짐을 챙긴다."
                android:textSize="14sp"
                android:textColor="#000000"
                android:background="@drawable/option_button_selector"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_option2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="짐은 여행 출발 전에만 챙기면 되지~"
                android:textSize="14sp"
                android:textColor="#000000"
                android:background="@drawable/option_button_selector"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


    </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="48dp"
        android:paddingVertical="16dp"
        android:background="@color/white">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="이전"
            android:backgroundTint="#EBEEF8"
            android:textColor="#6378C4"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="다음"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/menu_bottom_three"
        app:itemIconTint="@null"
        app:itemTextColor="@color/bnv_text_color"

        app:itemRippleColor="@android:color/transparent"
        app:itemBackground="@android:color/transparent"
        android:background="@color/white"
        app:itemActiveIndicatorStyle="@style/NoActiveIndicator"/>
</LinearLayout>
