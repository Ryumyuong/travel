<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_white_gray"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    tools:context=".SammyPassMainActivity">

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="환영합니다!"
        android:textAlignment="center"
        android:textColor="#3653AE"
        android:textSize="24sp"
        android:fontFamily="@font/noto_sans_kr"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Instruction Text -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-20dp"
        android:text="새미패스를 작성해주세요"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="20sp"
        android:fontFamily="@font/noto_sans_kr"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

    <!-- Sammy Image -->
    <ImageView
        android:id="@+id/ivSammy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:contentDescription="새미 캐릭터"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/sammy"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction"
        app:layout_constraintWidth_max="240dp" />

    <!-- Start Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="-20dp"
        android:background="@drawable/btn_blue_rounded"
        android:elevation="4dp"
        android:text="작성 시작하기"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:fontFamily="@font/noto_sans_kr"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivSammy"
        app:layout_constraintWidth_max="280dp" />

    <!-- Browse Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBrowse"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_dark_rounded"
        android:text="우선 둘러만 볼게요!"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:fontFamily="@font/noto_sans_kr"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnStart"
        app:layout_constraintWidth_max="280dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>